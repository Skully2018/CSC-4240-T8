# Copy this file to .env in the same folder as main.py.
# Create your own key at https://aistudio.google.com/apikey
# Use a project on Google's Free tier without billing enabled to avoid paid usage.
# Never commit or share .env. Do not place it inside web/.
GEMINI_API_KEY=paste_your_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45
